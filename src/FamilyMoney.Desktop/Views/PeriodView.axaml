<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
			 xmlns:controls="using:FamilyMoney.Navigation.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="using:FamilyMoney.ViewModels"
             x:DataType="vm:PeriodViewModel"
             x:Class="FamilyMoney.Views.PeriodView">
	<Grid ColumnDefinitions="auto auto auto" Height="50">
		<Button HotKey="Ctrl+D1" Command="{Binding ToDayCommand}" IsVisible="False" />
		<Button HotKey="Ctrl+D2" Command="{Binding ToMonthCommand}" IsVisible="False" />
		<Button HotKey="Ctrl+D3" Command="{Binding ToQuarterCommand}" IsVisible="False" />
		<Button HotKey="Ctrl+D4" Command="{Binding ToYearCommand}" IsVisible="False" />
		<Button HotKey="Ctrl+D5" Command="{Binding ToCustomCommand}" IsVisible="False" />

		<Button Classes="ToolNav"
				Command="{Binding PrevCommand}"
				HotKey="Ctrl+Left">
			<mi:MaterialIcon Kind="ChevronLeft" />
		</Button>
		<Button x:Name="PeriodButton"
				Grid.Column="1"
				Classes="ToolPill"
				Margin="4 0"
				HotKey="Ctrl+P"
				Click="OnPeriodClick">
			<StackPanel Orientation="Horizontal" Spacing="4">
				<TextBlock Text="{Binding Text}" VerticalAlignment="Center" />
				<mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
			</StackPanel>
		</Button>
		<Button Grid.Column="2"
				Classes="ToolNav"
				Command="{Binding NextCommand}"
				HotKey="Ctrl+Right">
			<mi:MaterialIcon Kind="ChevronRight" />
		</Button>

		<Popup x:Name="PeriodPopup"
			   PlacementTarget="{Binding #PeriodButton}"
			   Placement="Bottom"
			   VerticalOffset="4"
			   IsLightDismissEnabled="True">
			<controls:PeriodPicker x:Name="PeriodPickerControl" />
		</Popup>
	</Grid>
</UserControl>
