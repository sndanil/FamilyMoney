<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:FamilyMoney.ViewModels.Settings"
        xmlns:peer="using:FamilyMoney.Sync.Peer"
        mc:Ignorable="d"
        d:DesignWidth="520" d:DesignHeight="620"
        x:Class="FamilyMoney.PeerSyncWindow"
        x:DataType="vm:PeerHostViewModel"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Title="Синхронизация по Wi-Fi"
        Classes="Dialog">

    <Grid Margin="22" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Синхронизация по Wi-Fi" Classes="PageTitle" />
            <TextBlock Text="Телефон подключится к этому компьютеру напрямую. Оба приложения должны быть открыты. При первом запуске разрешите приложению доступ в частных сетях Windows."
                       Classes="Secondary"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="6">
            <TextBlock Text="Сетевой адрес" Classes="FieldLabel" />
            <ComboBox ItemsSource="{Binding Addresses}"
                      SelectedItem="{Binding SelectedAddress}"
                      IsEnabled="{Binding !IsRunning}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="peer:PeerNetworkAddress">
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{Binding EndpointText}"
                       Classes="Secondary"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="2"
                IsVisible="{Binding HasPairing}"
                Background="White"
                CornerRadius="8"
                Padding="12"
                HorizontalAlignment="Center">
            <Image x:Name="QrImage" Width="280" Height="280" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Row="3" Spacing="4">
            <TextBlock Text="{Binding Status}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding ExpiresText}"
                       Classes="Secondary"
                       FontSize="11"
                       TextWrapping="Wrap"
                       IsVisible="{Binding HasPairing}" />
        </StackPanel>

        <ProgressBar Grid.Row="4"
                     IsIndeterminate="True"
                     IsVisible="{Binding IsRunning}"
                     Height="4" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Classes="Outline"
                    Content="Обновить адреса"
                    Command="{Binding RefreshAddressesCommand}"
                    IsVisible="{Binding !IsRunning}" />
            <Button Classes="Primary"
                    Content="Начать"
                    Command="{Binding StartCommand}"
                    IsVisible="{Binding !IsRunning}" />
            <Button Classes="Outline"
                    Content="Остановить"
                    Command="{Binding StopCommand}"
                    IsVisible="{Binding IsRunning}" />
        </StackPanel>

        <Button Grid.Row="6"
                Classes="DialogButton"
                Content="Закрыть"
                Click="OnCloseClick"
                HorizontalAlignment="Right" />
    </Grid>
</Window>
