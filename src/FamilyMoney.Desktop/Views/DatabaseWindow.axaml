<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="520"
        x:Class="FamilyMoney.DatabaseWindow"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        xmlns:vm="using:FamilyMoney.ViewModels.Settings"
        x:DataType="vm:DatabaseViewModel"
        Classes="Dialog"
        Title="Параметры базы данных">
	<Window.Styles>
		<Style Selector="TabItem">
			<Setter Property="Padding" Value="14 8" />
			<Setter Property="FontSize" Value="14" />
		</Style>
		<Style Selector="TextBlock.FieldLabel">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="Margin" Value="0 0 0 4" />
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Margin" Value="0 0 0 12" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>
		<Style Selector="NumericUpDown">
			<Setter Property="Margin" Value="0 0 0 12" />
		</Style>
		<Style Selector="CheckBox">
			<Setter Property="Margin" Value="0 0 0 12" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,Auto" Margin="20 42 20 16">
		<TabControl Name="DatabaseTabs">
			<TabItem Header="Основное">
				<ScrollViewer MaxHeight="460">
					<StackPanel Margin="4 12 4 0">
						<TextBlock Text="Название" Classes="FieldLabel" />
						<TextBox Text="{Binding Name}" PlaceholderText="Например, Семейный бюджет" />

						<TextBlock Text="Файл базы" Classes="FieldLabel" />
						<Grid ColumnDefinitions="*,Auto" Margin="0 0 0 12">
							<TextBox Grid.Column="0"
									 Text="{Binding Path}"
									 Margin="0"
									 PlaceholderText="Путь к файлу базы" />
							<Button Grid.Column="1"
									Classes="DialogToolButton"
									Content="..."
									Margin="6 0 0 0"
									Command="{Binding BrowseDatabasePathCommand}" />
						</Grid>

						<TextBlock Text="Папка резервных копий" Classes="FieldLabel" />
						<Grid ColumnDefinitions="*,Auto" Margin="0 0 0 12">
							<TextBox Grid.Column="0"
									 Text="{Binding BackupsFolder}"
									 Margin="0"
									 PlaceholderText="Папка для резервных копий" />
							<Button Grid.Column="1"
									Classes="DialogToolButton"
									Content="..."
									Margin="6 0 0 0"
									Command="{Binding BrowseBackupsFolderCommand}" />
						</Grid>
						<TextBlock Text="Относительный путь создаётся рядом с файлом базы, в отдельной папке этой базы."
								   FontSize="11"
								   Foreground="{DynamicResource TextSecondaryBrush}"
								   TextWrapping="Wrap"
								   Margin="0 -8 0 12" />

						<TextBlock Text="Максимум резервных копий" Classes="FieldLabel" />
						<NumericUpDown Name="MaxBackups"
									   PlaceholderText="Максимум резервных копий"
									   FormatString="#,##0"
									   Minimum="0"
									   Value="{Binding MaxBackups}" />
						<TextBlock Text="0 — не создавать копии."
								   FontSize="11"
								   Foreground="{DynamicResource TextSecondaryBrush}"
								   Margin="0 -8 0 12" />
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem Header="Синхронизация">
				<ScrollViewer MaxHeight="520">
					<StackPanel Margin="4 12 4 0">
						<CheckBox IsChecked="{Binding Sync.Enabled}"
								  Content="Включить синхронизацию" />

						<TextBlock Text="Способ" Classes="FieldLabel" />
						<ComboBox ItemsSource="{Binding Sync.Providers}"
								  SelectedItem="{Binding Sync.SelectedProvider}"
								  Margin="0 0 0 12">
							<ComboBox.ItemTemplate>
								<DataTemplate x:DataType="vm:SyncProviderOption">
									<TextBlock Text="{Binding Title}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>

						<StackPanel IsVisible="{Binding Sync.IsS3}" Spacing="0">
							<TextBlock Text="Заполнить из шаблона" Classes="FieldLabel" />
							<ComboBox ItemsSource="{Binding Sync.S3.Presets}"
									  SelectedItem="{Binding Sync.S3.SelectedPreset}"
									  Margin="0 0 0 12">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:S3EndpointPreset">
										<TextBlock Text="{Binding Title}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>

							<TextBlock Text="URL сервиса" Classes="FieldLabel" />
							<TextBox Text="{Binding Sync.S3.ServiceUrl}"
									 PlaceholderText="https://s3.amazonaws.com" />

							<TextBlock Text="Bucket" Classes="FieldLabel" />
							<TextBox Text="{Binding Sync.S3.Bucket}" PlaceholderText="Имя bucket" />

							<TextBlock Text="Регион" Classes="FieldLabel" />
							<TextBox Text="{Binding Sync.S3.Region}" PlaceholderText="us-east-1" />

							<TextBlock Text="Access Key" Classes="FieldLabel" />
							<TextBox Text="{Binding Sync.S3.AccessKey}" PlaceholderText="Идентификатор ключа доступа" />

							<TextBlock Text="Secret Key" Classes="FieldLabel" />
							<TextBox Text="{Binding Sync.S3.SecretKey}"
									 PasswordChar="•"
									 PlaceholderText="Секретный ключ" />

							<CheckBox IsChecked="{Binding Sync.S3.ForcePathStyle}"
									  Content="Принудительный path-style (MinIO и совместимые хранилища)" />
						</StackPanel>

						<StackPanel IsVisible="{Binding Sync.IsWebDav}" Spacing="0">
							<TextBlock Text="Заполнить из шаблона" Classes="FieldLabel" />
							<ComboBox ItemsSource="{Binding Sync.WebDav.Presets}"
									  SelectedItem="{Binding Sync.WebDav.SelectedPreset}"
									  Margin="0 0 0 12">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:WebDavPreset">
										<TextBlock Text="{Binding Title}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>

							<TextBlock Text="Адрес WebDAV" Classes="FieldLabel" />
							<TextBox Text="{Binding Sync.WebDav.Url}"
									 PlaceholderText="https://webdav.cloud.mail.ru" />

							<TextBlock Text="Логин" Classes="FieldLabel" />
							<TextBox Text="{Binding Sync.WebDav.UserName}"
									 PlaceholderText="Почта или имя пользователя" />

							<TextBlock Text="Пароль приложения" Classes="FieldLabel" />
							<TextBox Text="{Binding Sync.WebDav.Password}"
									 PasswordChar="•"
									 PlaceholderText="Пароль приложения, не основной пароль" />

							<TextBlock Text="Пароль не попадает в QR-код: на втором устройстве его нужно ввести отдельно."
									   FontSize="11"
									   Foreground="{DynamicResource TextSecondaryBrush}"
									   TextWrapping="Wrap"
									   Margin="0 -4 0 10" />
						</StackPanel>

						<StackPanel IsVisible="{Binding Sync.IsFolder}" Spacing="0">
							<TextBlock Text="Каталог обмена" Classes="FieldLabel" />
							<Grid ColumnDefinitions="*,Auto" Margin="0 0 0 8">
								<TextBox Grid.Column="0"
										 Text="{Binding Sync.Folder.Path}"
										 Margin="0"
										 PlaceholderText="Папка для объектов синхронизации" />
								<Button Grid.Column="1"
										Classes="DialogToolButton"
										Content="..."
										Margin="6 0 0 0"
										Command="{Binding BrowseSyncFolderCommand}" />
							</Grid>
							<TextBlock Text="Сюда кладутся только дельты и снапшоты, не файл базы. Папку может синхронизировать Syncthing, Яндекс.Диск, OneDrive или сетевой диск."
									   FontSize="11"
									   Foreground="{DynamicResource TextSecondaryBrush}"
									   TextWrapping="Wrap"
									   Margin="0 0 0 12" />
						</StackPanel>

						<StackPanel Spacing="0">
							<CheckBox IsChecked="{Binding Sync.Encryption.Enabled}"
									  IsEnabled="{Binding !Sync.Encryption.Enabled}"
									  Content="Шифровать данные в хранилище" />
							<StackPanel IsVisible="{Binding Sync.Encryption.Enabled}" Spacing="0">
								<TextBlock Text="Парольная фраза" Classes="FieldLabel" />
								<TextBox Text="{Binding Sync.Encryption.Password}"
										 PasswordChar="•"
										 PlaceholderText="Не хранится; нужна для ключа" />
								<Button Content="Применить пароль"
										Command="{Binding Sync.Encryption.ApplyPasswordCommand}"
										HorizontalAlignment="Left"
										Margin="0 0 0 8" />

								<TextBlock Text="Код восстановления" Classes="FieldLabel" />
								<TextBox Text="{Binding Sync.Encryption.RecoveryCode}"
										 PlaceholderText="Вставьте сохранённый ключ" />
								<StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 0 8">
									<Button Content="Показать код"
											Command="{Binding Sync.Encryption.ShowRecoveryCodeCommand}"
											IsVisible="{Binding Sync.Encryption.HasKey}" />
									<Button Content="Применить код"
											Command="{Binding Sync.Encryption.ApplyRecoveryCodeCommand}" />
								</StackPanel>

								<TextBlock Text="{Binding Sync.Encryption.Status}"
										   FontSize="11"
										   Foreground="{DynamicResource TextSecondaryBrush}"
										   TextWrapping="Wrap"
										   Margin="0 0 0 8" />
								<TextBlock Text="Восстановить данные без парольной фразы нельзя. Ключ хранится на этом устройстве; в QR по умолчанию не передаётся. После включения шифрование нельзя отключить без пересоздания хранилища."
										   FontSize="11"
										   Foreground="{DynamicResource TextSecondaryBrush}"
										   TextWrapping="Wrap"
										   Margin="0 0 0 10" />
							</StackPanel>
						</StackPanel>

						<CheckBox IsChecked="{Binding Sync.PublishPeerChangesToCloud}"
								  Content="Публиковать принятые по Wi-Fi изменения в облако" />
						<TextBlock Text="Десктоп будет отправлять в S3 изменения, полученные от телефона по Wi-Fi. Телефон при этом может не делать облачную синхронизацию."
								   FontSize="11"
								   Foreground="{DynamicResource TextSecondaryBrush}"
								   TextWrapping="Wrap"
								   Margin="0 0 0 10" />

						<TextBlock Text="По умолчанию секреты синхронизации не попадают в QR-код. Для переноса на телефон, где нет формы ввода ключей, включите галочку в окне QR."
								   FontSize="11"
								   Foreground="{DynamicResource TextSecondaryBrush}"
								   TextWrapping="Wrap"
								   Margin="0 4 0 8" />
					</StackPanel>
				</ScrollViewer>
			</TabItem>
		</TabControl>

		<Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="4 14 4 0">
			<Button Classes="DialogButton"
					Content="QR-код"
					ToolTip.Tip="Показать QR-код с настройками базы данных и синхронизации"
					Click="OnShowQrClick">
				<Button.Flyout>
					<Flyout Placement="TopEdgeAlignedLeft">
						<StackPanel Spacing="8" Width="280">
							<TextBlock Text="Отсканируйте код в мобильном приложении"
									   TextWrapping="Wrap"
									   HorizontalAlignment="Center" />
							<CheckBox Content="Передавать ключи и пароли"
									  IsChecked="{Binding IncludeSecretsInQr}"
									  IsCheckedChanged="OnShowQrClick" />
							<TextBlock Text="Только для личного переноса: любой, кто увидит код, получит доступ к хранилищу."
									   FontSize="11"
									   Foreground="{DynamicResource TextSecondaryBrush}"
									   TextWrapping="Wrap"
									   IsVisible="{Binding IncludeSecretsInQr}" />
							<Image x:Name="QrImage" Width="260" Height="260" Stretch="Uniform" />
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>

			<TextBlock Grid.Column="1"
					   Text="{Binding ValidationMessage}"
					   Foreground="{DynamicResource NegativeBrush}"
					   FontSize="11"
					   TextWrapping="Wrap"
					   VerticalAlignment="Center"
					   Margin="12 0" />

			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
				<Button IsDefault="True" Classes="DialogButton" Content="OK" Command="{Binding OkCommand}" />
				<Button IsCancel="True" Classes="DialogButton" Content="Отмена" Command="{Binding CancelCommand}" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>
