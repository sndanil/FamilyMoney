<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="520"
        x:Class="FamilyMoney.DatabaseWindow"
        Width="620"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanMaximize="False"
        ExtendClientAreaToDecorationsHint="True"
        xmlns:vm="using:FamilyMoney.ViewModels.Settings"
        x:DataType="vm:DatabaseViewModel"
        Classes="Dialog"
        Title="Параметры базы данных">
	<Window.Styles>
		<Style Selector="TabItem">
			<Setter Property="Padding" Value="14 8" />
			<Setter Property="FontSize" Value="14" />
		</Style>
		<Style Selector="TextBlock.FieldLabel">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
			<Setter Property="Margin" Value="0 0 0 4" />
		</Style>
		<Style Selector="TextBox">
			<Setter Property="Margin" Value="0 0 0 12" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
		</Style>
		<Style Selector="NumericUpDown">
			<Setter Property="Margin" Value="0 0 0 12" />
		</Style>
		<Style Selector="CheckBox">
			<Setter Property="Margin" Value="0 0 0 12" />
		</Style>
	</Window.Styles>

	<Grid RowDefinitions="Auto,Auto" Margin="20 42 20 16">
		<TabControl Name="DatabaseTabs">
			<TabItem Header="Основное">
				<ScrollViewer MaxHeight="460">
					<StackPanel Margin="4 12 4 0">
						<TextBlock Text="Название" Classes="FieldLabel" />
						<TextBox Text="{Binding Name}" PlaceholderText="Например, Семейный бюджет" />

						<TextBlock Text="Файл базы" Classes="FieldLabel" />
						<Grid ColumnDefinitions="*,Auto" Margin="0 0 0 12">
							<TextBox Grid.Column="0"
									 Text="{Binding Path}"
									 Margin="0"
									 PlaceholderText="Путь к файлу базы" />
							<Button Grid.Column="1"
									Classes="DialogToolButton"
									Content="..."
									Margin="6 0 0 0"
									Command="{Binding BrowseDatabasePathCommand}" />
						</Grid>

						<TextBlock Text="Папка резервных копий" Classes="FieldLabel" />
						<Grid ColumnDefinitions="*,Auto" Margin="0 0 0 12">
							<TextBox Grid.Column="0"
									 Text="{Binding BackupsFolder}"
									 Margin="0"
									 PlaceholderText="Папка для резервных копий" />
							<Button Grid.Column="1"
									Classes="DialogToolButton"
									Content="..."
									Margin="6 0 0 0"
									Command="{Binding BrowseBackupsFolderCommand}" />
						</Grid>

						<TextBlock Text="Максимум резервных копий" Classes="FieldLabel" />
						<NumericUpDown Name="MaxBackups"
									   PlaceholderText="Максимум резервных копий"
									   FormatString="#,##0"
									   Minimum="0"
									   Value="{Binding MaxBackups}" />
					</StackPanel>
				</ScrollViewer>
			</TabItem>

			<TabItem Header="S3">
				<ScrollViewer MaxHeight="460">
					<StackPanel Margin="4 12 4 0">
						<CheckBox IsChecked="{Binding S3.Enabled}"
								  Content="Включить синхронизацию через S3" />

						<TextBlock Text="URL сервиса" Classes="FieldLabel" />
						<TextBox Text="{Binding S3.ServiceUrl}"
								 PlaceholderText="https://s3.amazonaws.com или адрес MinIO" />

						<TextBlock Text="Bucket" Classes="FieldLabel" />
						<TextBox Text="{Binding S3.Bucket}" PlaceholderText="Имя bucket" />

						<TextBlock Text="Регион" Classes="FieldLabel" />
						<TextBox Text="{Binding S3.Region}" PlaceholderText="us-east-1" />

						<TextBlock Text="Access Key" Classes="FieldLabel" />
						<TextBox Text="{Binding S3.AccessKey}" PlaceholderText="Идентификатор ключа доступа" />

						<TextBlock Text="Secret Key" Classes="FieldLabel" />
						<TextBox Text="{Binding S3.SecretKey}"
								 PasswordChar="•"
								 PlaceholderText="Секретный ключ" />

						<CheckBox IsChecked="{Binding S3.ForcePathStyle}"
								  Content="Принудительный path-style (MinIO и совместимые хранилища)" />
					</StackPanel>
				</ScrollViewer>
			</TabItem>
		</TabControl>

		<Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" Margin="4 14 4 0">
			<Button Classes="DialogButton"
					Content="QR-код"
					ToolTip.Tip="Показать QR-код с настройками базы данных и S3"
					Click="OnShowQrClick">
				<Button.Flyout>
					<Flyout Placement="TopEdgeAlignedLeft">
						<StackPanel Spacing="8" Width="280">
							<TextBlock Text="Отсканируйте код в мобильном приложении"
									   TextWrapping="Wrap"
									   HorizontalAlignment="Center" />
							<Image x:Name="QrImage" Width="260" Height="260" Stretch="Uniform" />
						</StackPanel>
					</Flyout>
				</Button.Flyout>
			</Button>

			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
				<Button IsDefault="True" Classes="DialogButton" Content="OK" Command="{Binding OkCommand}" />
				<Button IsCancel="True" Classes="DialogButton" Content="Отмена" Command="{Binding CancelCommand}" />
			</StackPanel>
		</Grid>
	</Grid>
</Window>
