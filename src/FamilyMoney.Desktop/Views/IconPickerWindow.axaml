<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:FamilyMoney.Navigation.Controls"
        xmlns:conv="using:FamilyMoney.Navigation.Converters"
        xmlns:services="using:FamilyMoney.Navigation.Services"
        xmlns:utils="using:FamilyMoney.Utils"
        xmlns:vm="using:FamilyMoney.Navigation.ViewModels"
        x:Class="FamilyMoney.Views.IconPickerWindow"
        x:DataType="vm:IconPickerViewModel"
        Width="760" Height="760"
        MinWidth="680" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Title="Иконка"
        Classes="Dialog">
  <Window.Resources>
    <conv:HexToBrushConverter x:Key="hexToBrush" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="14 8 14 12" />
      <Setter Property="MinHeight" Value="38" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
      <Setter Property="RenderTransform">
        <TranslateTransform Y="10" />
      </Setter>
    </Style>
    <Style Selector="TextBlock.Hint">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.IconTile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Width" Value="96" />
      <Setter Property="Height" Value="88" />
    </Style>
    <Style Selector="Button.IconTile:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
    </Style>
    <Style Selector="ListBox.IconGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="ListBox.IconGrid ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto,Auto" Margin="16">
    <TabControl Grid.Row="0"
                x:Name="Tabs"
                SelectedIndex="0"
                FontSize="14"
                SelectionChanged="OnTabChanged">
      <TabItem Header="Иконки">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0 6 0 0">
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="{Binding SearchPlaceholder}"
                   Margin="0 0 0 8" />
          <StackPanel Grid.Row="1" Spacing="2" Margin="0 0 0 8">
            <CheckBox Content="Все иконки Material (13 645)"
                      IsChecked="{Binding ShowAllIcons, Mode=TwoWay}" />
            <TextBlock Classes="Hint"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Text="{Binding AllIconsHint}" />
          </StackPanel>
          <ListBox Grid.Row="2"
                   Classes="IconGrid"
                   ItemsSource="{Binding Icons}"
                   SelectionChanged="OnIconSelected"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="utils:IconChoice">
                <StackPanel Width="88" Spacing="2" ToolTip.Tip="{Binding Label}">
                  <controls:IconBadge Icon="{Binding Spec}"
                                      BadgeSize="52"
                                      HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Label}"
                             FontSize="11"
                             HorizontalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="3"
                  Width="120"
                  Content="Показать ещё"
                  Classes="DialogButton"
                  HorizontalAlignment="Left"
                  Margin="0 8 0 0"
                  IsVisible="{Binding HasMoreAllIcons}"
                  Click="OnShowMoreAllIcons" />
        </Grid>
      </TabItem>

      <TabItem Header="Готовые">
        <Grid RowDefinitions="Auto,*" Margin="0 6 0 0">
          <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Поиск: сбер, альфа, карта"
                   Margin="0 0 0 8" />
          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ReadyGroups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="services:PackGroupView">
                  <StackPanel Spacing="4" Margin="0 0 0 14">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Title}"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Count}"
                                 FontSize="12"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 VerticalAlignment="Center" />
                    </Grid>
                    <ListBox Classes="IconGrid"
                             ItemsSource="{Binding Assets}"
                             SelectionChanged="OnPackSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="services:PackAssetView">
                          <StackPanel Width="118" Spacing="2" Margin="2">
                            <controls:IconBadge Icon="{Binding Spec}"
                                                BadgeSize="60"
                                                HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Name}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="112" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Буква">
        <StackPanel Margin="8 12 8 0" Spacing="10">
          <TextBlock Text="Буква или две" FontWeight="SemiBold" />
          <TextBox Text="{Binding LetterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   PlaceholderText="Например, ПП"
                   MaxLength="2"
                   Width="160"
                   HorizontalAlignment="Left" />
          <TextBlock Classes="Hint"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="По умолчанию — по первой букве каждого слова, не более двух." />
          <Border Background="{DynamicResource CardBackBrush}"
                  BorderBrush="{DynamicResource LikeGridLinesBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  Padding="16"
                  HorizontalAlignment="Left">
            <controls:IconBadge Icon="{Binding PreviewIcon}"
                                IconColor="{Binding PreviewColor}"
                                BadgeSize="72"
                                EntityName="{Binding EntityName}" />
          </Border>
        </StackPanel>
      </TabItem>

      <TabItem Header="Свой файл">
        <StackPanel Margin="8 12 8 0" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Выбрать файл"
                    Click="OnChooseFile"
                    HorizontalAlignment="Left"
                    Width="150"
                    Classes="DialogButton" />
            <Button Content="Вставить из буфера"
                    Click="OnPasteImage"
                    HorizontalAlignment="Left"
                    Width="170"
                    Classes="DialogButton"
                    ToolTip.Tip="Вставить картинку или файл изображения из буфера (Ctrl+V)" />
          </StackPanel>
          <TextBlock Classes="Hint"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     MaxWidth="700"
                     TextWrapping="Wrap"
                     Text="PNG, JPEG, WebP, SVG, BMP или GIF. Можно выбрать файл или вставить картинку из буфера. Автоматически повернётся по EXIF. «Заполнить» обрежет в квадрат, «Вписать» оставит поля. HEIC не поддерживается." />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <RadioButton x:Name="FillMode"
                         GroupName="FileFit"
                         Content="Заполнить квадрат"
                         IsChecked="True"
                         IsCheckedChanged="OnFileFitChanged" />
            <RadioButton x:Name="FitMode"
                         GroupName="FileFit"
                         Content="Вписать целиком"
                         IsCheckedChanged="OnFileFitChanged" />
          </StackPanel>

          <StackPanel x:Name="CropPanel" Spacing="2">
            <Grid ColumnDefinitions="70,*">
              <TextBlock Text="Масштаб"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <Slider Grid.Column="1"
                      x:Name="ZoomSlider"
                      Minimum="1"
                      Maximum="3"
                      Value="1"
                      ValueChanged="OnCropChanged" />
            </Grid>
            <Grid ColumnDefinitions="70,*">
              <TextBlock Text="Сдвиг X"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <Slider Grid.Column="1"
                      x:Name="OffsetXSlider"
                      Minimum="-1"
                      Maximum="1"
                      Value="0"
                      ValueChanged="OnCropChanged" />
            </Grid>
            <Grid ColumnDefinitions="70,*">
              <TextBlock Text="Сдвиг Y"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <Slider Grid.Column="1"
                      x:Name="OffsetYSlider"
                      Minimum="-1"
                      Maximum="1"
                      Value="0"
                      ValueChanged="OnCropChanged" />
            </Grid>
          </StackPanel>

          <CheckBox x:Name="RemoveBackground"
                    Content="Убрать однотонный фон"
                    IsCheckedChanged="OnRemoveBackgroundChanged" />

          <TextBlock x:Name="FileInfo"
                     Classes="Hint"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     MaxWidth="700"
                     TextWrapping="Wrap"
                     IsVisible="False" />
          <TextBlock x:Name="FileStatus"
                     Classes="Hint"
                     Foreground="{DynamicResource NegativeBrush}"
                     IsVisible="False" />
          <Border x:Name="CropPreview"
                  Width="180"
                  Height="180"
                  Background="{DynamicResource CardBackBrush}"
                  BorderBrush="{DynamicResource LikeGridLinesBrush}"
                  BorderThickness="1"
                  CornerRadius="12"
                  ClipToBounds="True"
                  HorizontalAlignment="Left"
                  Cursor="SizeAll"
                  PointerPressed="OnCropPointerPressed"
                  PointerMoved="OnCropPointerMoved"
                  PointerReleased="OnCropPointerReleased"
                  PointerWheelChanged="OnCropPointerWheel">
            <controls:IconBadge ImageData="{Binding PreviewImage}"
                                IconColor="{Binding PreviewColor}"
                                BadgeSize="180"
                                EntityName="{Binding EntityName}"
                                ShowFallback="False"
                                CollapseWhenEmpty="True"
                                IsHitTestVisible="False" />
          </Border>
        </StackPanel>
      </TabItem>
    </TabControl>

    <Grid x:Name="ColorPanel" Grid.Row="1" ColumnDefinitions="Auto,*" Margin="4 10 4 6">
      <TextBlock Text="Цвет:"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <ListBox Grid.Column="1"
               x:Name="ColorList"
               ItemsSource="{Binding Colors}"
               Background="Transparent"
               BorderThickness="0"
               SelectionChanged="OnColorSelected"
               Margin="8 0 0 0">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Width="24" Height="24" CornerRadius="12"
                    Background="{Binding Converter={StaticResource hexToBrush}}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="4 4 4 0">
      <Button Content="Без иконки"
              Click="OnClear"
              Classes="DialogButton"
              Width="130"
              HorizontalAlignment="Left" />

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="14"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center">
        <TextBlock Text="Так будет в списке:"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <controls:IconBadge Icon="{Binding PreviewIcon}"
                            IconColor="{Binding PreviewColor}"
                            ImageData="{Binding PreviewImage}"
                            EntityName="{Binding EntityName}"
                            BadgeSize="24" />
        <controls:IconBadge Icon="{Binding PreviewIcon}"
                            IconColor="{Binding PreviewColor}"
                            ImageData="{Binding PreviewImage}"
                            EntityName="{Binding EntityName}"
                            BadgeSize="36" />
        <controls:IconBadge Icon="{Binding PreviewIcon}"
                            IconColor="{Binding PreviewColor}"
                            ImageData="{Binding PreviewImage}"
                            EntityName="{Binding EntityName}"
                            BadgeSize="56" />
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button Content="OK"
                IsDefault="True"
                Click="OnOk"
                Classes="DialogButton" />
        <Button Content="Отмена"
                IsCancel="True"
                Click="OnCancel"
                Classes="DialogButton" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

