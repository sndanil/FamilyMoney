<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
			 xmlns:ia="clr-namespace:Avalonia.Xaml.Interactions.Core;assembly=Avalonia.Xaml.Interactions"
			 xmlns:icons="using:Material.Icons"
			 xmlns:controls="using:FamilyMoney.Navigation.Controls"
			 xmlns:cv="using:FamilyMoney.Converters"
             xmlns:vm="using:FamilyMoney.ViewModels"
			 x:DataType="vm:TransactionsViewModel"
			 x:Class="FamilyMoney.Views.TransactionsByDatesView">
	<UserControl.Resources>
		<cv:ByteArrayToBitmapConverter x:Key="byteArrayToBitmapConverter" />
		<cv:IsNegativeConverter x:Key="isNegativeConverter" />
		<cv:NoNewLinesConverter x:Key="noNewLinesConverter" />
		<cv:BoolToAngleConverter x:Key="boolToAngleConverter" />
	</UserControl.Resources>
	<UserControl.Styles>
		<Style Selector="Border.DayCard">
			<Setter Property="Margin" Value="2 4 2 8" />
			<Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="ClipToBounds" Value="True" />
		</Style>
		<Style Selector="Border.DayHeader">
			<Setter Property="MinHeight" Value="34" />
			<Setter Property="Padding" Value="10 4" />
			<Setter Property="Background" Value="{DynamicResource GroupBackBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
			<Setter Property="BorderThickness" Value="0 0 0 1" />
		</Style>
		<Style Selector="Border.DayHeader Grid">
			<Setter Property="Margin" Value="0" />
		</Style>
		<Style Selector="Border.DayHeader TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.DayExpander">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Width" Value="24" />
			<Setter Property="Height" Value="24" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="Margin" Value="0 0 4 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.DayExpander /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.DayExpander:pointerover">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.DayExpander:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.DayExpander:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.DayExpander mi|MaterialIcon">
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
		<Style Selector="Border.DayTransaction">
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Background" Value="{DynamicResource SystemAltMediumLowColor}" />
			<Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
			<Setter Property="BorderThickness" Value="0 0 0 1" />
		</Style>
		<Style Selector="Border.DayTransaction:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
		</Style>
		<Style Selector="Border.DayTransaction.Selected">
			<Setter Property="Background" Value="{DynamicResource SelectedBackBrush}" />
		</Style>
		<Style Selector="Border.DayTransaction > Grid">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="5 0" />
		</Style>
		<Style Selector="Border.DayTransaction.TransactionRow">
			<Setter Property="MinHeight" Value="30" />
		</Style>
		<Style Selector="Border.TransactionTag">
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="6 2" />
			<Setter Property="Margin" Value="0 1 2 0" />
			<Setter Property="Background" Value="{DynamicResource GroupBackBrush}" />
		</Style>
		<Style Selector="Border.TransactionTag TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.85" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="TextBlock.Name">
			<Setter Property="Margin" Value="15 0 0 0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
		<Style Selector="TextBlock.Title">
			<Setter Property="HorizontalAlignment" Value="Left" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>
		<Style Selector="SelectableTextBlock.Sum">
			<Setter Property="HorizontalAlignment" Value="Right" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0 0 4 0" />
		</Style>
		<Style Selector="SelectableTextBlock.Debet">
			<Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
		</Style>
		<Style Selector="mi|MaterialIcon">
			<Setter Property="Height" Value="14" />
			<Setter Property="Width" Value="14" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="Gray" />
		</Style>
		<Style Selector="Button.Expander">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
			<Setter Property="Height" Value="24" />
			<Setter Property="Width" Value="24" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="0" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="ToolTip.Placement" Value="Top" />
			<Setter Property="ToolTip.VerticalOffset" Value="-5" />
		</Style>
		<Style Selector="Button.Expander /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.Expander:pointerover">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.Expander:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.Expander:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.Expander mi|MaterialIcon">
			<Setter Property="Foreground" Value="Gray" />
		</Style>
		<Style Selector="Button.DayHeaderButton">
			<Setter Property="MinHeight" Value="34" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="{DynamicResource GroupBackBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
			<Setter Property="BorderThickness" Value="0 0 0 1" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Stretch" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">
						<ContentPresenter Content="{TemplateBinding Content}"
										  HorizontalContentAlignment="Stretch"
										  VerticalContentAlignment="Stretch" />
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.DayHeaderButton:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
		</Style>
		<Style Selector="Button.DayHeaderButton:pressed">
			<Setter Property="RenderTransform" Value="none" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer>
		<ItemsControl ItemsSource="{Binding TransactionsDyDates}">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<VirtualizingStackPanel Orientation="Vertical" />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>

			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Border Classes="DayCard">
					<StackPanel>
						<Button Classes="DayHeaderButton"
								Command="{Binding ToggleExpandCommand}"
								ToolTip.Tip="Свернуть / развернуть день">
							<Panel>
							<Grid>
								<Grid ColumnDefinitions="Auto,*,Auto" Margin="10 0">
									<mi:MaterialIcon Grid.Column="0"
													 Kind="ChevronRight"
													 Width="16" Height="16"
													 VerticalAlignment="Center"
													 RenderTransformOrigin="50%,50%">
										<mi:MaterialIcon.RenderTransform>
											<RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource boolToAngleConverter}}">
												<RotateTransform.Transitions>
													<Transitions>
														<DoubleTransition Property="Angle" Duration="0:0:0.18" />
													</Transitions>
												</RotateTransform.Transitions>
											</RotateTransform>
										</mi:MaterialIcon.RenderTransform>
									</mi:MaterialIcon>

									<StackPanel Grid.Column="2"
												Orientation="Horizontal"
												Spacing="12"
												HorizontalAlignment="Right"
												VerticalAlignment="Center">
										<SelectableTextBlock Classes="Sum Debet"
												   IsVisible="{Binding HasDebet}"
												   Text="{Binding DebetSum, StringFormat='#,##0.00'}" />
										<SelectableTextBlock Classes="Sum"
												   Classes.Negative="True"
												   IsVisible="{Binding HasCredit}"
												   Text="{Binding CreditSum, StringFormat='#,##0.00'}" />
										<SelectableTextBlock Classes="Sum"
												   Classes.Debet="{Binding IsDebet}"
												   Classes.Negative="{Binding !IsDebet}"
												   IsVisible="{Binding ShowTotal}"
												   Text="{Binding Sum, StringFormat='#,##0.00'}" />
									</StackPanel>
								</Grid>

								<StackPanel Orientation="Horizontal"
											Spacing="8"
											HorizontalAlignment="Center"
											VerticalAlignment="Center">
									<StackPanel.RenderTransform>
										<TranslateTransform X="-12" />
									</StackPanel.RenderTransform>
									<mi:MaterialIcon Kind="Calendar"
													 Width="16" Height="16"
													 VerticalAlignment="Center" />
									<TextBlock Classes="Title"
											   MinWidth="70"
											   Text="{Binding Date, StringFormat=dd MMMM yyyy}" />
								</StackPanel>
							</Grid>
							<controls:RippleLayer RippleBrush="{DynamicResource TextPrimaryBrush}" />
							</Panel>
						</Button>

						<ItemsControl ItemsSource="{Binding Transactions}"
									  IsVisible="{Binding IsExpanded}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Vertical" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>

							<ItemsControl.ItemTemplate>
								<DataTemplate>
									<Border Classes="DayTransaction TransactionRow" Classes.Selected="{Binding IsSelected}">
										<Interaction.Behaviors>
											<EventTriggerBehavior EventName="Tapped">
												<InvokeCommandAction Command="{Binding Parent.SelectCommand}" CommandParameter="{Binding}" />
											</EventTriggerBehavior>
											<EventTriggerBehavior EventName="DoubleTapped">
												<InvokeCommandAction Command="{Binding Parent.EditCommand}" CommandParameter="{Binding}" />
											</EventTriggerBehavior>
										</Interaction.Behaviors>

										<Grid ColumnDefinitions="30 30 24 130 200 * 100">
											<Button Grid.Column="0"
													Classes="Expander"
													Command="{Binding Parent.CopyCommand}"
													CommandParameter="{Binding}"
													ToolTip.Tip="Копировать">
												<mi:MaterialIcon Kind="ContentCopy" />
											</Button>

											<Button Grid.Column="1" Classes="Expander" ToolTip.Tip="Удалить">
												<Button.Flyout>
													<MenuFlyout>
														<MenuItem Width="200" Header="Удалить"
																  Command="{Binding Parent.DeleteCommand}"
																  CommandParameter="{Binding}" />
													</MenuFlyout>
												</Button.Flyout>

												<mi:MaterialIcon Kind="Delete" />
											</Button>

											<controls:IconBadge Grid.Column="2"
															BadgeSize="24"
															ImageData="{Binding Category.ImageData}"
															Icon="{Binding Category.Icon}"
															IconColor="{Binding Category.IconColor}"
															EntityName="{Binding Category.Name}"
															Fallback="{x:Static icons:MaterialIconKind.TagOutline}"
															VerticalAlignment="Center" />
											<TextBlock Grid.Column="3" Classes="Name" Text="{Binding Category.Name}" />
											<TextBlock Grid.Column="4" Classes="Name" Text="{Binding SubCategory.Name}" />
											<Grid Grid.Column="5" Margin="10 4 0 4" ColumnDefinitions="* auto">
												<TextBlock Classes="Name"
														   Margin="0"
														   DockPanel.Dock="Left"
														   Text="{Binding Comment, Converter={StaticResource noNewLinesConverter}}"
														   TextTrimming="CharacterEllipsis" />
												<ItemsControl ItemsSource="{Binding Tags}"
																IsVisible="{Binding HasTags}"
																Grid.Column="1">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<StackPanel Orientation="Horizontal" />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate>
															<Border Classes="TransactionTag">
																<TextBlock Text="{Binding}" />
															</Border>
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</Grid>
											<SelectableTextBlock Grid.Column="6"
																 Classes="Sum"
																 Classes.Debet="{Binding IsDebet}"
																 Text="{Binding Sum, StringFormat='#,##0.00'}" />
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</StackPanel>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</ScrollViewer>
</UserControl>
