<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:icons="using:Material.Icons"
             xmlns:controls="using:FamilyMoney.Navigation.Controls"
             xmlns:cv="using:FamilyMoney.Converters"
             xmlns:views="clr-namespace:FamilyMoney.Views"
             xmlns:vm="using:FamilyMoney.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:DataType="vm:TopExpensesViewModel"
             x:Class="FamilyMoney.Views.TopExpensesView"
             Focusable="True">

	<UserControl.Resources>
		<cv:BoolToAngleConverter x:Key="boolToAngleConverter" />
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="Button.Segment">
			<Setter Property="Width" Value="40" />
			<Setter Property="Height" Value="32" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Background" Value="{DynamicResource GroupBackBrush}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.Segment:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
		</Style>
		<Style Selector="Button.Segment.Active">
			<Setter Property="Background" Value="{DynamicResource SelectedBackBrush}" />
		</Style>
		<Style Selector="TextBlock.FilterLabel">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		</Style>

		<!-- Карточка топа -->
		<Style Selector="Border.ExpenseCard">
			<Setter Property="Width" Value="300" />
			<Setter Property="Height" Value="128" />
			<Setter Property="Margin" Value="0 0 14 14" />
			<Setter Property="Padding" Value="14" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="Border.ExpenseCard:pointerover">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
			<Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
		</Style>
		<Style Selector="Border.ExpenseCard.Selected">
			<Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="Background" Value="{DynamicResource SelectedBackBrush}" />
		</Style>

		<!-- Панель операций: день и строки как в дневном списке -->
		<Style Selector="Border.DayCard">
			<Setter Property="Margin" Value="12 4 12 8" />
			<Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="ClipToBounds" Value="True" />
		</Style>
		<Style Selector="Button.DayHeaderButton">
			<Setter Property="MinHeight" Value="34" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Background" Value="{DynamicResource GroupBackBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
			<Setter Property="BorderThickness" Value="0 0 0 1" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Stretch" />
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">
						<ContentPresenter Content="{TemplateBinding Content}"
										  HorizontalContentAlignment="Stretch"
										  VerticalContentAlignment="Stretch" />
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<Style Selector="Button.DayHeaderButton:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
		</Style>
		<Style Selector="Button.DayHeaderButton:pressed">
			<Setter Property="RenderTransform" Value="none" />
		</Style>
		<Style Selector="Border.DayTransaction">
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
			<Setter Property="BorderThickness" Value="0 0 0 1" />
		</Style>
		<Style Selector="Border.TransactionTag">
			<Setter Property="CornerRadius" Value="6" />
			<Setter Property="Padding" Value="5 1" />
			<Setter Property="Margin" Value="0 0 2 0" />
			<Setter Property="Background" Value="{DynamicResource GroupBackBrush}" />
		</Style>
		<Style Selector="Border.TransactionTag TextBlock">
			<Setter Property="FontSize" Value="10" />
			<Setter Property="Opacity" Value="0.85" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.PanelClose">
			<Setter Property="Width" Value="30" />
			<Setter Property="Height" Value="30" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.PanelClose:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,Auto,*">

		<!-- Фильтры отчёта -->
		<WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0 4 0 0">
			<StackPanel Orientation="Horizontal" Spacing="8" Margin="0 0 14 8">
				<TextBlock Classes="FilterLabel" Text="Счёт" />
				<ComboBox Width="240"
						  Height="32"
						  VerticalAlignment="Center"
						  ItemsSource="{Binding Scopes}"
						  SelectedItem="{Binding SelectedScope, Mode=TwoWay}">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ReportAccount">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Border Width="{Binding IndentWidth}" />
								<controls:IconBadge BadgeSize="18"
													ShowFallback="False"
													CollapseWhenEmpty="True"
													ImageData="{Binding ImageData}"
													Icon="{Binding Icon}"
													IconColor="{Binding IconColor}"
													EntityName="{Binding Name}"
													Fallback="{x:Static icons:MaterialIconKind.FolderOutline}"
													VerticalAlignment="Center" />
								<TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>

			<StackPanel Orientation="Horizontal" Spacing="8" Margin="0 0 14 8">
				<TextBlock Classes="FilterLabel" Text="Период" />
				<views:PeriodPickerView DataContext="{Binding Period}" />
			</StackPanel>

			<StackPanel Orientation="Horizontal" Spacing="8" Margin="0 0 14 8">
				<TextBlock Classes="FilterLabel" Text="Топ" />
				<StackPanel Orientation="Horizontal" Spacing="4">
					<Button Classes="Segment" Classes.Active="{Binding IsTop10}" Command="{Binding SetTop10Command}" Content="10" />
					<Button Classes="Segment" Classes.Active="{Binding IsTop20}" Command="{Binding SetTop20Command}" Content="20" />
					<Button Classes="Segment" Classes.Active="{Binding IsTop50}" Command="{Binding SetTop50Command}" Content="50" />
					<Button Classes="Segment" Classes.Active="{Binding IsTop100}" Command="{Binding SetTop100Command}" Content="100" />
				</StackPanel>
			</StackPanel>

			<CheckBox IsChecked="{Binding Merge, Mode=TwoWay}"
					  Content="Объединять повторы"
					  VerticalAlignment="Center"
					  Margin="0 0 14 8" />
		</WrapPanel>

		<!-- Сводка — одна строка, слева направо -->
		<TextBlock Grid.Row="1"
				   Text="{Binding SummaryText}"
				   Margin="0 0 0 10"
				   FontSize="12"
				   Foreground="{DynamicResource TextSecondaryBrush}"
				   VerticalAlignment="Center"
				   TextTrimming="CharacterEllipsis" />

		<!-- Карточки и панель операций -->
		<Grid Grid.Row="2" Name="Body" ColumnDefinitions="*,4,0">

			<Panel Grid.Column="0">
				<ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{Binding Items}" Margin="0 0 -14 -14">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel Orientation="Horizontal" />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:TopExpenseCardViewModel">
								<Border Classes="ExpenseCard"
										Classes.Selected="{Binding IsSelected}"
										Cursor="Hand"
										Tapped="OnCardTapped">
									<Grid RowDefinitions="Auto,Auto,Auto,*">
										<Grid ColumnDefinitions="Auto,*,Auto">
											<controls:IconBadge BadgeSize="26"
																ImageData="{Binding ImageData}"
																Icon="{Binding Icon}"
																IconColor="{Binding IconColor}"
																EntityName="{Binding CategoryName}"
																Fallback="{x:Static icons:MaterialIconKind.TagOutline}"
																VerticalAlignment="Center" />

											<StackPanel Grid.Column="1" Margin="10 0 0 0" VerticalAlignment="Center">
												<TextBlock Text="{Binding CategoryName}"
														   FontSize="13"
														   FontWeight="SemiBold"
														   TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding SubCategoryName}"
														   MinHeight="15"
														   FontSize="11"
														   TextTrimming="CharacterEllipsis" />
											</StackPanel>

											<TextBlock Grid.Column="2"
													   Text="{Binding CountText}"
													   IsVisible="{Binding ShowCount}"
													   Margin="6 2 0 0"
													   FontSize="10"
													   VerticalAlignment="Top"
													   Foreground="{DynamicResource TextSecondaryBrush}" />
										</Grid>

										<TextBlock Grid.Row="1"
												   Text="{Binding CommentSingleLine}"
												   MinHeight="15"
												   Margin="0 6 0 0"
												   FontSize="11"
												   MaxLines="1"
												   Foreground="{DynamicResource TextSecondaryBrush}"
												   TextTrimming="CharacterEllipsis" />

										<Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0 4 0 0">
											<SelectableTextBlock Text="{Binding Sum, StringFormat='#,##0.00'}"
																 FontSize="15"
																 FontWeight="SemiBold" />
											<TextBlock Grid.Column="1"
													   Text="{Binding Percent, StringFormat=P0}"
													   FontSize="11"
													   VerticalAlignment="Bottom"
													   Foreground="{DynamicResource TextSecondaryBrush}" />
										</Grid>

										<ProgressBar Grid.Row="3"
													 Minimum="0"
													 Maximum="1"
													 Value="{Binding Percent}"
													 Height="4"
													 VerticalAlignment="Bottom"
													 Background="{DynamicResource LikeGridLinesBrush}"
													 Foreground="{DynamicResource AccentBrush}"
													 CornerRadius="2" />
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<TextBlock Text="{Binding EmptyText}"
						   IsVisible="{Binding EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
						   HorizontalAlignment="Center"
						   VerticalAlignment="Center"
						   FontSize="13"
						   Foreground="{DynamicResource TextSecondaryBrush}" />
			</Panel>

			<GridSplitter Grid.Column="1"
						  Name="DetailsSplitter"
						  ResizeDirection="Columns"
						  Background="Transparent"
						  IsVisible="{Binding IsDetailsOpen}" />

			<Border Grid.Column="2"
					Name="DetailsPanel"
					IsVisible="False"
					ClipToBounds="True"
					CornerRadius="10"
					Background="{DynamicResource CardBackBrush}"
					BorderBrush="{DynamicResource LikeGridLinesBrush}"
					BorderThickness="1">
				<Grid Name="DetailsContent" RowDefinitions="Auto,*" MinWidth="320">
					<StackPanel Margin="16 14 12 10" Spacing="6">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<controls:IconBadge BadgeSize="26"
												ImageData="{Binding DetailsImageData}"
												Icon="{Binding DetailsIcon}"
												IconColor="{Binding DetailsIconColor}"
												EntityName="{Binding DetailsCategory}"
												Fallback="{x:Static icons:MaterialIconKind.TagOutline}"
												VerticalAlignment="Center" />

							<StackPanel Grid.Column="1" Margin="10 0 4 0" VerticalAlignment="Center" Spacing="1">
								<TextBlock Text="{Binding DetailsCategory}"
										   FontSize="14"
										   FontWeight="SemiBold"
										   TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{Binding DetailsSubCategory}"
										   IsVisible="{Binding HasDetailsSubCategory}"
										   FontSize="12"
										   TextTrimming="CharacterEllipsis" />
								<TextBlock Text="{Binding DetailsComment}"
										   IsVisible="{Binding HasDetailsComment}"
										   Margin="0 4 0 0"
										   FontSize="11"
										   Foreground="{DynamicResource TextSecondaryBrush}"
										   TextWrapping="Wrap" />
							</StackPanel>

							<Button Grid.Column="2"
									Classes="PanelClose"
									Command="{Binding ClosePanelCommand}"
									ToolTip.Tip="Закрыть">
								<mi:MaterialIcon Kind="Close" />
							</Button>
						</Grid>

						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Text="{Binding DetailsTotalText}" FontSize="14" FontWeight="SemiBold" />
							<TextBlock Text="{Binding DetailsMetaText}"
									   FontSize="11"
									   VerticalAlignment="Center"
									   Foreground="{DynamicResource TextSecondaryBrush}" />
						</StackPanel>
					</StackPanel>

					<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
						<ItemsControl ItemsSource="{Binding Details}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Orientation="Vertical" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:ExpenseDayGroupViewModel">
									<Border Classes="DayCard">
										<StackPanel>
											<Button Classes="DayHeaderButton"
													Command="{Binding ToggleCommand}"
													ToolTip.Tip="Свернуть / развернуть день">
												<Panel>
												<Grid ColumnDefinitions="Auto,*,Auto" Margin="10 0">
													<mi:MaterialIcon Grid.Column="0"
																	 Kind="ChevronRight"
																	 Width="14" Height="14"
																	 VerticalAlignment="Center"
																	 RenderTransformOrigin="50%,50%">
														<mi:MaterialIcon.RenderTransform>
															<RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource boolToAngleConverter}}">
																<RotateTransform.Transitions>
																	<Transitions>
																		<DoubleTransition Property="Angle" Duration="0:0:0.18" />
																	</Transitions>
																</RotateTransform.Transitions>
															</RotateTransform>
														</mi:MaterialIcon.RenderTransform>
													</mi:MaterialIcon>

													<TextBlock Grid.Column="1"
															   Text="{Binding DateText}"
															   Margin="8 0 0 0"
															   FontSize="12"
															   FontWeight="SemiBold"
															   VerticalAlignment="Center" />

													<SelectableTextBlock Grid.Column="2"
																		 Text="{Binding Sum, StringFormat='#,##0.00'}"
																		 FontSize="12"
																		 VerticalAlignment="Center" />
												</Grid>
												<controls:RippleLayer RippleBrush="{DynamicResource TextPrimaryBrush}" />
												</Panel>
											</Button>

											<ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
												<ItemsControl.ItemsPanel>
													<ItemsPanelTemplate>
														<StackPanel Orientation="Vertical" />
													</ItemsPanelTemplate>
												</ItemsControl.ItemsPanel>
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="vm:ExpenseRowViewModel">
														<Border Classes="DayTransaction">
															<Grid ColumnDefinitions="22,Auto,*,Auto,Auto" Margin="8 0">
																<controls:IconBadge Grid.Column="0"
																					BadgeSize="18"
																					ImageData="{Binding ImageData}"
																					Icon="{Binding Icon}"
																					IconColor="{Binding IconColor}"
																					EntityName="{Binding AccountName}"
																					Fallback="{x:Static icons:MaterialIconKind.WalletOutline}"
																					VerticalAlignment="Center" />

																<TextBlock Grid.Column="1"
																		   Text="{Binding AccountName}"
																		   MaxWidth="150"
																		   Margin="6 0 0 0"
																		   FontSize="12"
																		   VerticalAlignment="Center"
																		   TextTrimming="CharacterEllipsis" />

																<ItemsControl Grid.Column="3"
																			  ItemsSource="{Binding Tags}"
																			  IsVisible="{Binding HasTags}"
																			  Margin="8 0 0 0"
																			  VerticalAlignment="Center">
																	<ItemsControl.ItemsPanel>
																		<ItemsPanelTemplate>
																			<StackPanel Orientation="Horizontal" />
																		</ItemsPanelTemplate>
																	</ItemsControl.ItemsPanel>
																	<ItemsControl.ItemTemplate>
																		<DataTemplate>
																			<Border Classes="TransactionTag">
																				<TextBlock Text="{Binding}" />
																			</Border>
																		</DataTemplate>
																	</ItemsControl.ItemTemplate>
																</ItemsControl>

																<SelectableTextBlock Grid.Column="4"
																					 Margin="8 0 0 0"
																					 Text="{Binding Sum, StringFormat='#,##0.00'}"
																					 FontSize="12"
																					 VerticalAlignment="Center"
																					 HorizontalAlignment="Right" />
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>
