<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:c="using:FamilyMoney.Controls"
             xmlns:cv="using:FamilyMoney.Converters"
             xmlns:vm="using:FamilyMoney.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:DataType="vm:ReportsViewModel"
             x:Class="FamilyMoney.Views.ReportsView">

	<UserControl.Resources>
		<cv:ByteArrayToBitmapConverter x:Key="byteArrayToBitmapConverter" />
		<cv:BoolToFontWeightConverter x:Key="boolToFontWeightConverter" />
	</UserControl.Resources>

	<UserControl.Styles>
		<Style Selector="Button.TimelineTool">
			<Setter Property="Width" Value="34" />
			<Setter Property="Height" Value="34" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Background" Value="{DynamicResource GroupBackBrush}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.TimelineTool:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
		</Style>
		<Style Selector="Border.LegendMark">
			<Setter Property="Width" Value="10" />
			<Setter Property="Height" Value="10" />
			<Setter Property="CornerRadius" Value="2" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="48,44,*" Margin="20 0 8 8">

		<!-- Заголовок раздела -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
			<TextBlock Text="Отчёты" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
			<Border CornerRadius="13"
					Background="{DynamicResource SelectedBackBrush}"
					Padding="12 4"
					VerticalAlignment="Center">
				<TextBlock Text="Таймлайн" FontSize="11" FontWeight="SemiBold" />
			</Border>
		</StackPanel>

		<!-- Счёт и масштаб -->
		<Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto">
			<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
				<TextBlock Text="Счёт"
						   FontSize="12"
						   Foreground="{DynamicResource TextSecondaryBrush}"
						   VerticalAlignment="Center" />
				<ComboBox Width="240"
						  Height="36"
						  VerticalAlignment="Center"
						  ItemsSource="{Binding Timeline.Scopes}"
						  SelectedItem="{Binding Timeline.SelectedScope, Mode=TwoWay}">
					<ComboBox.ItemTemplate>
						<DataTemplate x:DataType="vm:TimelineScope">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Border Width="{Binding IndentWidth}" />
								<Image Width="18"
									   Height="18"
									   Stretch="Uniform"
									   VerticalAlignment="Center"
									   Source="{Binding ImageData, Converter={StaticResource byteArrayToBitmapConverter}}"
									   IsVisible="{Binding ImageData, Converter={x:Static ObjectConverters.IsNotNull}}" />
								<TextBlock Text="{Binding Name}"
										   VerticalAlignment="Center"
										   FontWeight="{Binding IsGroup, Converter={StaticResource boolToFontWeightConverter}}" />
							</StackPanel>
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>

			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
				<Button Classes="TimelineTool"
						Command="{Binding Timeline.ZoomOutCommand}"
						ToolTip.Tip="Уменьшить масштаб">
					<mi:MaterialIcon Kind="MagnifyMinus" />
				</Button>
				<Button Classes="TimelineTool"
						Command="{Binding Timeline.ZoomInCommand}"
						ToolTip.Tip="Увеличить масштаб">
					<mi:MaterialIcon Kind="MagnifyPlus" />
				</Button>
			</StackPanel>
		</Grid>

		<!-- Карточка графика -->
		<Border Grid.Row="2"
				Background="{DynamicResource CardBackBrush}"
				BorderBrush="{DynamicResource LikeGridLinesBrush}"
				BorderThickness="1"
				CornerRadius="10">
			<Grid RowDefinitions="36,*">
				<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16 4 16 0">
					<StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<Border Classes="LegendMark" Background="{DynamicResource AccentBrush}" />
							<TextBlock Text="Баланс" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<Border Classes="LegendMark" Background="{DynamicResource PositiveBrush}" />
							<TextBlock Text="Доходы" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
							<Border Classes="LegendMark" Background="{DynamicResource NegativeBrush}" />
							<TextBlock Text="Расходы" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
						</StackPanel>
					</StackPanel>

					<StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right">
						<TextBlock Text="остаток на конец диапазона"
								   FontSize="10"
								   HorizontalAlignment="Right"
								   Foreground="{DynamicResource TextSecondaryBrush}" />
						<SelectableTextBlock Text="{Binding Timeline.EndBalanceText}"
											 FontSize="13"
											 FontWeight="SemiBold"
											 HorizontalAlignment="Right" />
					</StackPanel>
				</Grid>

				<Panel Grid.Row="1">
					<c:TimelineControl Name="TimelineChart"
									   Model="{Binding Timeline.RenderModel}"
									   AccentBrush="{DynamicResource AccentBrush}"
									   PositiveBrush="{DynamicResource PositiveBrush}"
									   NegativeBrush="{DynamicResource NegativeBrush}"
									   GridBrush="{DynamicResource LikeGridLinesBrush}"
									   SecondaryTextBrush="{DynamicResource TextSecondaryBrush}"
									   TextBrush="{DynamicResource TextPrimaryBrush}"
									   CardBrush="{DynamicResource CardBackBrush}" />

					<TextBlock Text="{Binding Timeline.EmptyText}"
							   IsVisible="{Binding Timeline.EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}"
							   HorizontalAlignment="Center"
							   VerticalAlignment="Center"
							   FontSize="13"
							   Foreground="{DynamicResource TextSecondaryBrush}" />

					<TextBlock Text="Загрузка…"
							   IsVisible="{Binding Timeline.IsLoading}"
							   HorizontalAlignment="Right"
							   VerticalAlignment="Bottom"
							   Margin="0 0 18 10"
							   FontSize="11"
							   Foreground="{DynamicResource TextSecondaryBrush}" />
				</Panel>
			</Grid>
		</Border>
	</Grid>
</UserControl>
