<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:FamilyMoney.Views"
             xmlns:vm="using:FamilyMoney.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:DataType="vm:ReportsViewModel"
             x:Class="FamilyMoney.Views.ReportsView">

	<UserControl.Styles>
		<Style Selector="Button.Mode">
			<Setter Property="CornerRadius" Value="13" />
			<Setter Property="Padding" Value="14 6" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
		</Style>
		<Style Selector="Button.Mode:pointerover">
			<Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
		</Style>
		<Style Selector="Button.Mode.Active">
			<Setter Property="Background" Value="{DynamicResource SelectedBackBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="48,*" Margin="20 0 8 8">

		<!-- Заголовок раздела и переключатель режимов -->
		<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
			<TextBlock Text="Отчёты"
					   FontSize="18"
					   FontWeight="SemiBold"
					   VerticalAlignment="Center"
					   Margin="0 0 8 0" />
			<Button Classes="Mode"
					Classes.Active="{Binding IsTimeline}"
					Command="{Binding ShowTimelineCommand}"
					Content="Таймлайн" />
			<Button Classes="Mode"
					Classes.Active="{Binding IsTopExpenses}"
					Command="{Binding ShowTopExpensesCommand}"
					Content="Топ расходов" />
		</StackPanel>

		<Panel Grid.Row="1">
			<Panel IsVisible="{Binding IsTimeline}">
				<views:TimelineReportView DataContext="{Binding Timeline}" />
			</Panel>

			<Panel IsVisible="{Binding IsTopExpenses}">
				<views:TopExpensesView DataContext="{Binding TopExpenses}" />
			</Panel>
		</Panel>
	</Grid>
</UserControl>
