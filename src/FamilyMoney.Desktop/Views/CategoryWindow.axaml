<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:cv="using:FamilyMoney.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
		xmlns:icons="using:Material.Icons"
		xmlns:controls="using:FamilyMoney.Navigation.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
		Width="600" Height="400"
		WindowStartupLocation="CenterOwner"
		ExtendClientAreaToDecorationsHint="True"
		xmlns:views="clr-namespace:FamilyMoney.Views"
		xmlns:vm="using:FamilyMoney.ViewModels"
		x:DataType="vm:BaseCategoryViewModel"
        x:Class="FamilyMoney.Views.CategoryWindow"
		Classes="Dialog"
        Title="Параметры категории">
	<Window.Resources>
		<cv:ByteArrayToBitmapConverter x:Key="byteArrayToBitmapConverter" />
	</Window.Resources>
<Window.Styles>
		<Style Selector="CheckBox">
			<Setter Property="Margin" Value="20 0" />
		</Style>
	</Window.Styles>
	<Grid RowDefinitions="auto auto * auto auto">
		<TextBox Text="{Binding Name}" Margin="15 35 15 5" PlaceholderText="Наименование" HorizontalAlignment="Stretch"/>
		<StackPanel Grid.Row="1" Orientation="Horizontal">
			<CheckBox IsChecked="{Binding IsHidden}">Скрытая для выбора</CheckBox>
		</StackPanel>
		<Border Grid.Row="2"
				Name="ImageControl"
				DragDrop.AllowDrop="True"
				Background="Transparent"
				HorizontalAlignment="Center"
				VerticalAlignment="Center">
			<controls:IconBadge ImageData="{Binding ImageData}"
								Icon="{Binding Icon}"
								IconColor="{Binding IconColor}"
								EntityName="{Binding Name}"
								Fallback="{x:Static icons:MaterialIconKind.TagOutline}"
								BadgeSize="112" />
		</Border>

		<Button Grid.Row="3"
				Classes="DialogButton"
				Width="250"
				Content="Выбрать иконку"
				HorizontalAlignment="Center"
				x:Name="ChangeImageButton"
				Click="ChangeImage"
				/>

		<StackPanel
			Grid.Row="4"
			Orientation="Horizontal"
			HorizontalAlignment="Right"
			Margin="0 5 0 10"
			>
			<Button IsDefault="True" Classes="DialogButton" Content="OK" Command="{Binding OkCommand}" CommandParameter="{Binding}" />
			<Button IsCancel="True" Classes="DialogButton" Content="Отмена" Command="{Binding CancelCommand}"/>
		</StackPanel>
	</Grid>
</Window>
