<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="440" d:DesignHeight="360"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        xmlns:vm="using:FamilyMoney.ViewModels"
        x:DataType="vm:MergeSubCategoriesViewModel"
        x:Class="FamilyMoney.Views.MergeSubCategoriesWindow"
        Classes="Dialog"
        Title="Объединить подкатегории">
	<Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24 40 24 16">
		<TextBlock Text="Выберите подкатегорию, которая останется"
				   FontSize="16"
				   FontWeight="SemiBold"
				   TextWrapping="Wrap" />
		<TextBlock Grid.Row="1"
				   Margin="0 8 0 12"
				   FontSize="12"
				   TextWrapping="Wrap"
				   Foreground="{DynamicResource TextSecondaryBrush}"
				   Text="Транзакции остальных будут перенесены в неё, а сами подкатегории удалены." />

		<ScrollViewer Grid.Row="2" MaxHeight="320">
			<ItemsControl ItemsSource="{Binding Candidates}">
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:MergeSubCategoryCandidateViewModel">
						<RadioButton GroupName="MergeTarget"
									 IsChecked="{Binding IsChosen}"
									 Margin="0 4">
							<StackPanel Spacing="2">
								<TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
								<TextBlock Text="{Binding TransactionCountText}"
										   FontSize="11"
										   Foreground="{DynamicResource TextSecondaryBrush}" />
							</StackPanel>
						</RadioButton>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<StackPanel Grid.Row="3"
					Orientation="Horizontal"
					HorizontalAlignment="Right"
					Margin="0 16 0 0">
			<Button IsDefault="True" Classes="DialogButton" Content="Объединить" Command="{Binding OkCommand}" />
			<Button IsCancel="True" Classes="DialogButton" Content="Отмена" Command="{Binding CancelCommand}" />
		</StackPanel>
	</Grid>
</Window>
