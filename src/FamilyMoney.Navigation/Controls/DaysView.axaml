<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:FamilyMoney.Navigation.Controls"
             xmlns:cv="using:FamilyMoney.Navigation.Converters"
             xmlns:vm="using:FamilyMoney.ViewModels"
             x:Class="FamilyMoney.Navigation.Controls.DaysView"
             x:DataType="vm:MainViewModel">
  <UserControl.Resources>
    <cv:ByteArrayToBitmapConverter x:Key="byteArrayToBitmapConverter" />
    <cv:NoNewLinesConverter x:Key="noNewLinesConverter" />
    <cv:BoolToAngleConverter x:Key="boolToAngleConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.DayCard">
      <Setter Property="Margin" Value="0 0 0 8" />
      <Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.DayHeaderButton">
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource GroupBackBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
      <Setter Property="BorderThickness" Value="0 0 0 1" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.DayHeaderButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
    </Style>
    <Style Selector="Button.DayHeaderButton:pressed">
      <Setter Property="RenderTransform" Value="none" />
    </Style>
    <Style Selector="TextBlock.DayTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.DayTransaction">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Padding" Value="14 8" />
      <Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
      <Setter Property="BorderThickness" Value="0 0 0 1" />
    </Style>
    <Style Selector="Border.DayTransaction:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
    </Style>
    <Style Selector="Border.TransactionTag">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="6 2" />
      <Setter Property="Margin" Value="0 1 2 0" />
      <Setter Property="Background" Value="{DynamicResource SelectedBackBrush}" />
    </Style>
    <Style Selector="Border.TransactionTag TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.85" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.Name">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.Comment">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="SelectableTextBlock.Sum">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8 0 0 0" />
    </Style>
    <Style Selector="SelectableTextBlock.Debet">
      <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.Negative">
      <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
    </Style>
    <Style Selector="Image.Category">
      <Setter Property="Margin" Value="0 0 8 0" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Width" Value="20" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Transactions.TransactionsDyDates}" Margin="5 5 5 88">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>

      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="DayCard">
            <StackPanel>
              <Button Classes="DayHeaderButton"
                      Command="{Binding ToggleExpandCommand}"
                      ToolTip.Tip="Свернуть / развернуть день">
                <Panel>
                <Grid>
                  <Grid ColumnDefinitions="Auto,*,Auto" Margin="12 0">
                    <mi:MaterialIcon Grid.Column="0"
                                     Kind="ChevronRight"
                                     Width="18"
                                     Height="18"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     RenderTransformOrigin="50%,50%">
                      <mi:MaterialIcon.RenderTransform>
                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource boolToAngleConverter}}">
                          <RotateTransform.Transitions>
                            <Transitions>
                              <DoubleTransition Property="Angle" Duration="0:0:0.18" />
                            </Transitions>
                          </RotateTransform.Transitions>
                        </RotateTransform>
                      </mi:MaterialIcon.RenderTransform>
                    </mi:MaterialIcon>

                    <SelectableTextBlock Grid.Column="2"
                                         Classes="Sum"
                                         Classes.Debet="{Binding IsDebet}"
                                         Classes.Negative="{Binding !IsDebet}"
                                         Text="{Binding Sum, StringFormat='#,##0.00'}" />
                  </Grid>

                  <StackPanel Orientation="Horizontal"
                              Spacing="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                    <StackPanel.RenderTransform>
                      <TranslateTransform X="-13" />
                    </StackPanel.RenderTransform>
                    <mi:MaterialIcon Kind="Calendar"
                                     Width="18"
                                     Height="18"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Classes="DayTitle"
                               Text="{Binding Date, StringFormat=dd MMMM yyyy}" />
                  </StackPanel>
                </Grid>
                <controls:RippleLayer RippleBrush="{DynamicResource TextPrimaryBrush}" />
                </Panel>
              </Button>

              <ItemsControl ItemsSource="{Binding Transactions}"
                            IsVisible="{Binding IsExpanded}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="DayTransaction" Tapped="OnTransactionTapped">
                      <Grid ColumnDefinitions="Auto * Auto">
                        <Image Classes="Category"
                               Stretch="Uniform"
                               Source="{Binding Category.ImageData, Converter={StaticResource byteArrayToBitmapConverter}}"
                               IsVisible="{Binding Category.ImageData, Converter={x:Static ObjectConverters.IsNotNull}}" />

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                          <WrapPanel Orientation="Horizontal" ItemSpacing="6">
                            <TextBlock Classes="Name" Text="{Binding CategoryName}" />
                            <TextBlock Classes="Name"
                                       Opacity="0.8"
                                       Text="{Binding SubCategory.Name}"
                                       IsVisible="{Binding SubCategory, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          </WrapPanel>
                          <TextBlock Classes="Comment"
                                     Text="{Binding Comment, Converter={StaticResource noNewLinesConverter}}"
                                     IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Classes="TransactionTag">
                                  <TextBlock Text="{Binding}" />
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <SelectableTextBlock Grid.Column="2"
                                             Classes="Sum"
                                             Classes.Debet="{Binding IsDebet}"
                                             Text="{Binding Sum, StringFormat='#,##0.00'}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
