<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:FamilyMoney.Navigation.Controls"
             xmlns:vm="using:FamilyMoney.ViewModels"
             x:Class="FamilyMoney.Navigation.Pages.HomePage"
             x:DataType="vm:MainViewModel"
             Header="Главная">
    <ContentPage.Resources>
        <MenuFlyout x:Key="SyncMenu">
            <MenuItem Header="Синхронизировать сейчас" Click="OnSyncCloudClick" />
            <MenuItem Header="По Wi-Fi…" Click="OnPeerSyncClick" />
            <MenuItem Header="-" IsEnabled="False" Classes="MenuSeparator" />
            <MenuItem Header="Настройки синхронизации" Click="OnSyncSettingsClick" />
        </MenuFlyout>
    </ContentPage.Resources>

    <ContentPage.Styles>
        <Style Selector="Border.Total">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
            <Setter Property="BorderThickness" Value="0 0 1 0" />
            <Setter Property="Padding" Value="16 8" />
        </Style>
        <Style Selector="Border.Total TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.Transaction">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
            <Setter Property="BorderThickness" Value="1 0 1 1" />
            <Setter Property="Padding" Value="16 8" />
        </Style>
        <Style Selector="Border.Transaction:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
        </Style>
        <Style Selector="Border.TransactionTag">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6 2" />
            <Setter Property="Margin" Value="0 1 2 0" />
            <Setter Property="Background" Value="{DynamicResource SelectedBackBrush}" />
        </Style>
        <Style Selector="Border.TransactionTag TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.Name">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.Comment">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="SelectableTextBlock.Sum">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8 0 0 0" />
        </Style>
        <Style Selector="SelectableTextBlock.Debet">
            <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.Negative">
            <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
        </Style>
        <Style Selector="Image.Category">
            <Setter Property="Margin" Value="0 0 8 0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Period">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10 0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.PeriodNav">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.PeriodNav:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
        </Style>
        <Style Selector="Button.HeaderIcon">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4 0 0 0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.HeaderIcon:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
        </Style>
        <Style Selector="ToggleButton.HeaderIcon">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4 0 0 0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.HeaderIcon:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
        </Style>
        <Style Selector="ToggleButton.HeaderIcon:checked">
            <Setter Property="Background" Value="{DynamicResource SelectedBackBrush}" />
        </Style>
        <Style Selector="mi|MaterialIcon">
            <Setter Property="Height" Value="14" />
            <Setter Property="Width" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </ContentPage.Styles>

    <Grid RowDefinitions="Auto *" Background="{DynamicResource SidebarBackBrush}">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="4" Margin="8 6 8 0">
            <Button Classes="PeriodNav"
                    Command="{Binding Period.PrevCommand}">
                <mi:MaterialIcon Kind="ChevronLeft" />
            </Button>
            <Button x:Name="PeriodButton"
                    Grid.Column="1"
                    Classes="Period"
                    ToolTip.Tip="Выбрать период"
                    Click="OnPeriodClick">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Period.Text}" VerticalAlignment="Center" />
                    <mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Classes="PeriodNav"
                    Command="{Binding Period.NextCommand}">
                <mi:MaterialIcon Kind="ChevronRight" />
            </Button>
            <Button x:Name="SyncButton"
                    Grid.Column="4"
                    Classes="HeaderIcon"
                    Click="OnSyncClick"
                    IsVisible="{Binding Settings.HasAnySync}"
                    IsEnabled="{Binding !Settings.IsSyncing}"
                    ToolTip.Tip="Синхронизация">
                <mi:MaterialIcon Kind="Sync" Classes.SyncSpin="{Binding Settings.IsSyncing}">
                    <mi:MaterialIcon.RenderTransform>
                        <RotateTransform />
                    </mi:MaterialIcon.RenderTransform>
                </mi:MaterialIcon>
            </Button>
            <ToggleButton Grid.Column="5"
                          Classes="HeaderIcon"
                          IsChecked="{Binding IsSummaryMode, Mode=TwoWay}"
                          IsVisible="{Binding !IsWideLayout}"
                          ToolTip.Tip="Сводка по категориям">
                <Panel>
                    <mi:MaterialIcon Kind="ViewGrid"
                                     Width="18"
                                     Height="18"
                                     IsVisible="{Binding IsSummaryMode}" />
                    <mi:MaterialIcon Kind="CalendarMonth"
                                     Width="18"
                                     Height="18"
                                     IsVisible="{Binding !IsSummaryMode}" />
                </Panel>
            </ToggleButton>
        </Grid>

        <Popup x:Name="PeriodPopup"
               Grid.Row="0"
               PlacementTarget="{Binding #PeriodButton}"
               Placement="Bottom"
               VerticalOffset="4"
               IsLightDismissEnabled="True">
            <controls:PeriodPicker x:Name="PeriodPickerControl" />
        </Popup>

        <Grid Grid.Row="1">
            <!-- Узкий экран: либо дни, либо сводка, переключаются кнопкой в шапке. -->
            <Grid IsVisible="{Binding !IsWideLayout}">
                <controls:DaysView IsVisible="{Binding !IsSummaryMode}" />
                <controls:TransactionsSummaryView x:Name="CompactSummary"
                                                  IsVisible="{Binding IsSummaryMode}" />
            </Grid>

            <!-- Широкий экран: сводка слева, дни или выбранная категория справа. -->
            <Grid x:Name="WideLayoutGrid" IsVisible="{Binding IsWideLayout}" ColumnDefinitions="340 *">
                <controls:TransactionsSummaryView x:Name="WideSummary"
                                                  Grid.Column="0"
                                                  Margin="0 0 6 0" />
                <Grid Grid.Column="1" Margin="6 0 0 0">
                    <controls:DaysView x:Name="WideDays" />
                    <controls:CategoryGroupedView x:Name="WideCategory" IsVisible="False" />
                </Grid>
            </Grid>

            <controls:TransactionsActionBar />
        </Grid>
    </Grid>
</ContentPage>
