<ContentPage xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:FamilyMoney.Navigation.Controls"
             xmlns:cv="using:FamilyMoney.Navigation.Converters"
             xmlns:vm="using:FamilyMoney.ViewModels"
             x:Class="FamilyMoney.Navigation.Pages.HomePage"
             x:DataType="vm:MainViewModel"
             Header="Главная">
    <ContentPage.Resources>
        <cv:ByteArrayToBitmapConverter x:Key="byteArrayToBitmapConverter" />
        <cv:NoNewLinesConverter x:Key="noNewLinesConverter" />
    </ContentPage.Resources>

    <ContentPage.Styles>
        <Style Selector="Border.Total">
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource GroupBackBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
            <Setter Property="BorderThickness" Value="0 0 1 0" />
            <Setter Property="Padding" Value="16 8" />
        </Style>
        <Style Selector="Border.Total TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.Transaction">
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{DynamicResource CardBackBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LikeGridLinesBrush}" />
            <Setter Property="BorderThickness" Value="1 0 1 1" />
            <Setter Property="Padding" Value="16 8" />
        </Style>
        <Style Selector="Border.Transaction:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
        </Style>
        <Style Selector="Border.TransactionTag">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6 2" />
            <Setter Property="Margin" Value="0 1 2 0" />
            <Setter Property="Background" Value="{DynamicResource SelectedBackBrush}" />
        </Style>
        <Style Selector="Border.TransactionTag TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.Name">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.Comment">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="SelectableTextBlock.Sum">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8 0 0 0" />
        </Style>
        <Style Selector="SelectableTextBlock.Debet">
            <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.Negative">
            <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
        </Style>
        <Style Selector="Image.Category">
            <Setter Property="Margin" Value="0 0 8 0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.Period">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10 0" />
        </Style>
        <Style Selector="Button.HeaderIcon">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4 0 0 0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.HeaderIcon:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
        </Style>
        <Style Selector="ToggleButton.HeaderIcon">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4 0 0 0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.HeaderIcon:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBackBrush}" />
        </Style>
        <Style Selector="ToggleButton.HeaderIcon:checked">
            <Setter Property="Background" Value="{DynamicResource SelectedBackBrush}" />
        </Style>
        <Style Selector="mi|MaterialIcon">
            <Setter Property="Height" Value="14" />
            <Setter Property="Width" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </ContentPage.Styles>

    <Grid RowDefinitions="Auto *" Background="{DynamicResource SidebarBackBrush}">
        <Grid ColumnDefinitions="Auto * Auto Auto Auto" Margin="8 8 8 0">
            <Button Classes="Period"
                    CornerRadius="12 0 0 12"
                    Command="{Binding Period.PrevCommand}">
                <mi:MaterialIcon Kind="ChevronLeft" />
            </Button>
            <Button x:Name="PeriodButton"
                    Grid.Column="1"
                    Classes="Period"
                    CornerRadius="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    ToolTip.Tip="Выбрать период"
                    Click="OnPeriodClick">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="{Binding Period.Text}" VerticalAlignment="Center" />
                    <mi:MaterialIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2"
                    Classes="Period"
                    CornerRadius="0 12 12 0"
                    Command="{Binding Period.NextCommand}">
                <mi:MaterialIcon Kind="ChevronRight" />
            </Button>
            <Button Grid.Column="3"
                    Classes="HeaderIcon"
                    Command="{Binding Settings.SyncNowCommand}"
                    IsVisible="{Binding Settings.IsSyncAvailable}"
                    IsEnabled="{Binding !Settings.IsSyncing}"
                    ToolTip.Tip="Синхронизировать">
                <mi:MaterialIcon Kind="Sync" Classes.SyncSpin="{Binding Settings.IsSyncing}">
                    <mi:MaterialIcon.RenderTransform>
                        <RotateTransform />
                    </mi:MaterialIcon.RenderTransform>
                </mi:MaterialIcon>
            </Button>
            <ToggleButton Grid.Column="4"
                          Classes="HeaderIcon"
                          IsChecked="{Binding IsSummaryMode, Mode=TwoWay}"
                          ToolTip.Tip="Сводка по категориям">
                <Panel>
                    <mi:MaterialIcon Kind="ViewGrid"
                                     Width="18"
                                     Height="18"
                                     IsVisible="{Binding IsSummaryMode}" />
                    <mi:MaterialIcon Kind="CalendarMonth"
                                     Width="18"
                                     Height="18"
                                     IsVisible="{Binding !IsSummaryMode}" />
                </Panel>
            </ToggleButton>
        </Grid>

        <Popup x:Name="PeriodPopup"
               Grid.Row="0"
               PlacementTarget="{Binding #PeriodButton}"
               Placement="Bottom"
               VerticalOffset="4"
               IsLightDismissEnabled="True">
            <controls:PeriodPicker x:Name="PeriodPickerControl" />
        </Popup>

        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsSummaryMode}">
            <ItemsControl ItemsSource="{Binding Transactions.TransactionsDyDates}"
                          Margin="5 5 5 88">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border Classes="Total">
                                <Grid ColumnDefinitions="* Auto">
                                    <TextBlock Text="{Binding Date, StringFormat=dd MMMM yyyy}" HorizontalAlignment="Center" />
                                    <SelectableTextBlock Grid.Column="1"
                                                         Classes="Sum"
                                                         Classes.Debet="{Binding IsDebet}"
                                                         Classes.Negative="{Binding !IsDebet}"
                                                         Text="{Binding Sum, StringFormat='#,##0.00'}" />
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding Transactions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="Transaction" Tapped="OnTransactionTapped">
                                            <Grid ColumnDefinitions="Auto * Auto">
                                                <Image Classes="Category"
                                                       Stretch="Uniform"
                                                       Source="{Binding Category.ImageData, Converter={StaticResource byteArrayToBitmapConverter}}"
                                                       IsVisible="{Binding Category.ImageData, Converter={x:Static ObjectConverters.IsNotNull}}" />

                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6">
                                                        <TextBlock Classes="Name" Text="{Binding CategoryName}" />
                                                        <TextBlock Classes="Name"
                                                                   Opacity="0.8"
                                                                   Text="{Binding SubCategory.Name}"
                                                                   IsVisible="{Binding SubCategory, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                    </WrapPanel>
                                                    <TextBlock Classes="Comment"
                                                               Text="{Binding Comment, Converter={StaticResource noNewLinesConverter}}"
                                                               IsVisible="{Binding Comment, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Classes="TransactionTag">
                                                                    <TextBlock Text="{Binding}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <SelectableTextBlock Grid.Column="2"
                                                                     Classes="Sum"
                                                                     Classes.Debet="{Binding IsDebet}"
                                                                     Text="{Binding Sum, StringFormat='#,##0.00'}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <controls:TransactionsSummaryView Grid.Row="1"
                                          IsVisible="{Binding IsSummaryMode}" />

        <controls:TransactionsActionBar Grid.Row="1" />
    </Grid>
</ContentPage>
