<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>FamilyMoney.Navigation</RootNamespace>
    <LangVersion>preview</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      Хостовые приложения ссылаются на ресурсы этой сборки через avares://.
      Если XAML-компилятор видит reference assembly (в нём нет встроенных
      ресурсов), сборка падает с «Unable to resolve !AvaloniaResources».
      Поэтому reference assembly для этой библиотеки не генерируем.
    -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.8.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Themes\**" />
    <AvaloniaResource Include="Assets\Packs\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FamilyMoney\FamilyMoney.csproj" />
  </ItemGroup>

</Project>
